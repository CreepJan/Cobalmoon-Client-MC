{
  "$description": "Cobalmoon Client design tokens — single source of truth. Format: W3C Design Tokens (DTCG). Run `node design-tokens/scripts/build.mjs` after editing.",
  "color": {
    "night": {
      "$type": "color",
      "$value": "#10182C",
      "$description": "Azul noche — main backgrounds, dark panels"
    },
    "lunar": {
      "$type": "color",
      "$value": "#7486B8",
      "$description": "Azul lunar — secondary elements, borders, muted text, inactive states"
    },
    "accent": {
      "$type": "color",
      "$value": "#52E0D0",
      "$description": "Turquesa — primary accent: buttons, selection, active toggles, default crosshair"
    },
    "stone": {
      "$type": "color",
      "$value": "#E9EDF2",
      "$description": "Blanco piedra — primary text, icons, hairlines"
    },
    "night-sunken": {
      "$type": "color",
      "$value": "#0B1120",
      "$description": "Derived: deeper background (window chrome, sidebars)"
    },
    "night-raised": {
      "$type": "color",
      "$value": "#141D35",
      "$description": "Derived: raised panels and cards"
    },
    "night-overlay": {
      "$type": "color",
      "$value": "#222E4F",
      "$description": "Derived: hover / popovers"
    },
    "accent-strong": {
      "$type": "color",
      "$value": "#7FF0E3",
      "$description": "Derived: accent hover/pressed"
    },
    "on-accent": {
      "$type": "color",
      "$value": "#10182C",
      "$description": "Text and icons drawn on top of the accent (stone on accent fails WCAG)"
    },
    "danger": {
      "$type": "color",
      "$value": "#FF7A88",
      "$description": "Errors and destructive actions"
    },
    "warning": {
      "$type": "color",
      "$value": "#FFC86B",
      "$description": "Warnings (e.g. Safe Server Mode notices)"
    }
  },
  "radius": {
    "sm": { "$type": "dimension", "$value": "4px" },
    "md": { "$type": "dimension", "$value": "8px" },
    "lg": { "$type": "dimension", "$value": "14px" }
  },
  "space": {
    "xs": { "$type": "dimension", "$value": "4px" },
    "sm": { "$type": "dimension", "$value": "8px" },
    "md": { "$type": "dimension", "$value": "16px" },
    "lg": { "$type": "dimension", "$value": "24px" },
    "xl": { "$type": "dimension", "$value": "40px" }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "normal": { "$type": "duration", "$value": "220ms" },
    "slow": { "$type": "duration", "$value": "380ms" },
    "easing": { "$type": "cubicBezier", "$value": [0.22, 1, 0.36, 1] }
  },
  "font": {
    "ui": { "$type": "fontFamily", "$value": "\"Inter\", \"Segoe UI\", system-ui, sans-serif" },
    "mono": { "$type": "fontFamily", "$value": "\"JetBrains Mono\", \"Cascadia Mono\", ui-monospace, monospace" }
  },
  "$contrast": {
    "$description": "Foreground/background pairs that must meet WCAG. level AA = 4.5:1 (text), AA-large/UI = 3:1. Checked in CI by scripts/check-contrast.mjs.",
    "pairs": [
      { "fg": "stone", "bg": "night", "level": "AA" },
      { "fg": "stone", "bg": "night-sunken", "level": "AA" },
      { "fg": "stone", "bg": "night-raised", "level": "AA" },
      { "fg": "stone", "bg": "night-overlay", "level": "AA" },
      { "fg": "lunar", "bg": "night", "level": "AA" },
      { "fg": "lunar", "bg": "night-sunken", "level": "AA" },
      { "fg": "lunar", "bg": "night-raised", "level": "AA" },
      { "fg": "accent", "bg": "night", "level": "AA" },
      { "fg": "accent", "bg": "night-raised", "level": "AA" },
      { "fg": "on-accent", "bg": "accent", "level": "AA" },
      { "fg": "on-accent", "bg": "accent-strong", "level": "AA" },
      { "fg": "danger", "bg": "night", "level": "AA" },
      { "fg": "warning", "bg": "night", "level": "AA" },
      { "fg": "lunar", "bg": "night-overlay", "level": "UI" }
    ]
  }
}
